; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RTS"
config/tags=PackedStringArray("private", "prototype", "real_time_strategy")
run/main_scene="res://node_3d.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[audio]

buses/default_bus_layout=""
nexus_resonance/logger/categories_enabled={}
nexus_resonance/logger/output_to_file=false
nexus_resonance/logger/file_path="user://nexus_resonance_log.ndjson"
nexus_resonance/logger/steam_audio_verbose=false
nexus_resonance/bus="Master"
nexus_resonance/reverb_bus_name="ResonanceReverb"
nexus_resonance/bake/output_dir="res://audio_data/"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[display]

window/size/viewport_width=750
window/size/viewport_height=750
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="Realtime Strategy"

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://_2D3D_Triangulation/": "red",
"res://old but useful stuff/Old Scripts/": "gray"
}

[input]

moveCamera={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":4,"position":Vector2(494, 4),"global_position":Vector2(503, 50),"factor":1.0,"button_index":3,"canceled":false,"pressed":true,"double_click":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":256,"position":Vector2(168, 8),"global_position":Vector2(177, 56),"factor":1.0,"button_index":9,"canceled":false,"pressed":true,"double_click":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":true,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":2,"position":Vector2(401, 13),"global_position":Vector2(410, 61),"factor":1.0,"button_index":2,"canceled":false,"pressed":true,"double_click":false,"script":null)
