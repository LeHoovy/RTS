; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RTS"
config/tags=PackedStringArray("private", "prototype", "real_time_strategy")
run/main_scene="uid://blif5g8ckxnwo"
config/features=PackedStringArray("4.5", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/size/borderless=true
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="Pathfinding test"

[editor_plugins]

enabled=PackedStringArray("res://addons/nklbdev.importality/plugin.cfg")

[file_customization]

folder_colors={
"res://_2D3D_Triangulation/": "red",
"res://old but useful stuff/Old Scripts/": "gray"
}

